{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "1.0.0",
  "identifier": "com.orbit.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orbit",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "devCsp": null,
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/llama-server"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Build, run and ship iOS and Android apps without Xcode or Android Studio.",
    "copyright": "© 2026 Rishabh Verma. All rights reserved.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "windowSize": {
          "width": 560,
          "height": 360
        }
      },
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES": "THIRD_PARTY_NOTICES"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxMEQyMUUxOEY2MzRCQzIKUldUQ1MyT1A0U0VOSVgyUWpvdVZlRHFyOE5RczRKTFpPdGlaekFQenl4elRITjlwZ3Bsc3MydjEK",
      "endpoints": [
        "https://github.com/aryan2621/orbit-ide/releases/latest/download/latest.json"
      ]
    }
  }
}
